@PACKAGE_INIT@

# Load the targets from the export
include("${CMAKE_CURRENT_LIST_DIR}/mrpt_libros_bridgeTargets.cmake")

# Provide backward compatibility target: mrpt::ros1bridge
if(NOT TARGET mrpt::ros1bridge AND TARGET mrpt::mrpt_libros_bridge)
  # Re-expose the bridge target as a global imported interface
  add_library(mrpt::ros1bridge INTERFACE IMPORTED GLOBAL)

  # Propagate include paths and linked library from the original target
  set_target_properties(mrpt::ros1bridge PROPERTIES
    INTERFACE_LINK_LIBRARIES mrpt::mrpt_libros_bridge
    INTERFACE_INCLUDE_DIRECTORIES "$<TARGET_PROPERTY:mrpt::mrpt_libros_bridge,INTERFACE_INCLUDE_DIRECTORIES>"
  )
endif()

# Make sure mrpt-apps is also found:
include(CMakeFindDependencyMacro)

find_dependency(mrpt-apps REQUIRED)
